{
    "name": "drupal/varbase_ai_vdb_milvus",
    "description": "Connects a Varbase site to a Milvus or Zilliz Cloud vector database for AI Search, inside the same DDEV project or on a remote server. Experimental: the Milvus VDB provider has no stable release. No custom PHP or shell code.",
    "type": "drupal-recipe",
    "version": "1.0.0-beta2",
    "keywords": [
        "recipe",
        "Varbase recipes",
        "Drupal recipes",
        "Varbase AI",
        "Drupal AI",
        "AI Search",
        "RAG",
        "vector database",
        "Milvus",
        "Zilliz Cloud"
    ],
    "license": "GPL-2.0-or-later",
    "homepage": "https://www.drupal.org/project/varbase_ai_vdb_milvus",
    "authors": [
        {
            "name": "Vardot",
            "homepage": "https://www.vardot.com",
            "role": "Maintainer"
        }
    ],
    "support": {
        "issues": "https://www.drupal.org/project/issues/varbase_ai_vdb_milvus",
        "source": "https://git.drupalcode.org/project/varbase_ai_vdb_milvus"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "drupal/ai": "^1.4",
        "drupal/ai_vdb_provider_milvus": "^1.1@beta",
        "drupal/core": "^11.4",
        "drupal/key": "^1.18",
        "drupal/search_api": "^1.40"
    }
}
